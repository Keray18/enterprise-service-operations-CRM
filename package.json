{
  "name": "enterprise-sales-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise After-Sales Service CRM Monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "type-check": "pnpm --filter backend type-check && pnpm --filter frontend type-check",
    "lint": "pnpm --filter backend lint && pnpm --filter frontend lint",
    "test": "pnpm --filter backend test && pnpm --filter frontend test",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:status": "pnpm --filter backend db:status",
    "db:bootstrap-admin": "pnpm --filter backend db:bootstrap-admin",
    "db:rotate-admin": "pnpm --filter backend db:rotate-admin",
    "db:users": "pnpm --filter backend db:users",
    "db:set-password": "pnpm --filter backend db:set-password"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
