{
  "name": "@crm/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express REST API for Enterprise Sales CRM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/database/runMigrations.ts",
    "db:status": "tsx src/database/runMigrations.ts --status",
    "db:bootstrap-admin": "tsx src/scripts/bootstrapAdmin.ts",
    "db:rotate-admin": "tsx src/scripts/rotateAdminPassword.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "oracledb": "^6.7.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/oracledb": "^7.0.3",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
